<?xml version="1.0" encoding="UTF-8"?>
<!-- Permission gate of the editor (feature document S4): every internal user edits documents
     by default; removing the group from a user withdraws the tool (the save route refuses).
     Odoo 18+ groups hang from a privilege (res.groups.privilege), no longer a category. The
     implication is written on this module's group (implied_by_ids is the inverse of the same
     relation): a <record> that writes base.group_user, a noupdate record, is silently skipped
     on module update. -->
<odoo>

    <record id="privilege_offiz_craft" model="res.groups.privilege">
        <field name="name">Ofizz Craft</field>
        <field name="description">Edit chatter documents with WordCraft and PdfCraft</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_craft_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_offiz_craft"/>
        <!-- Every internal user belongs to it: base.group_user implies this group. -->
        <field name="implied_by_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<!-- Permission gate of the editor (feature document S4): every internal user edits documents
     by default; removing the group from a user withdraws the tool (the save route refuses).
     Odoo 18 groups hang from a category (ir.module.category); privileges only exist from
     Odoo 19 on. The implication follows the pre-19 core pattern (hr_attendance,
     hr_recruitment): base.group_user lists this group in implied_ids. base.group_user is a
     noupdate record, so on module update that write is silently skipped — the implication
     already lives in the database. -->
<odoo>

    <record id="category_offiz_craft" model="ir.module.category">
        <field name="name">Ofizz Craft</field>
        <field name="description">Edit chatter documents with WordCraft and PdfCraft</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_craft_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="category_offiz_craft"/>
    </record>

    <!-- Every internal user belongs to it: base.group_user implies this group. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_craft_user'))]"/>
    </record>

</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<!-- Adds "Edit with <App>" to the chatter attachments (feature doc S2): a button in the
     action aside of Odoo 15's mail.AttachmentCard (the messaging model renders cards for
     non-image files). Shown only for formats an editor opens (craft_router.js); the save
     route enforces the user group server-side. -->
<templates xml:space="preserve">

    <t t-inherit="mail.AttachmentCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_AttachmentCard_aside')]" position="inside">
            <button t-if="attachmentCard.craftEditorFor()"
                    class="btn d-flex align-items-center justify-content-center w-100 h-100 rounded-0 bg-500"
                    t-att-title="'Edit with ' + attachmentCard.craftEditorFor().label"
                    t-att-data-craft-editor="attachmentCard.craftEditorFor().app"
                    t-on-click="(ev) => attachmentCard.onClickCraftEdit(ev)">
                <i class="fa fa-pencil o-text-white" role="img"
                   t-att-aria-label="'Edit with ' + attachmentCard.craftEditorFor().label"/>
            </button>
        </xpath>
    </t>

</templates>
